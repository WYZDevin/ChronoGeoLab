# Environment Configuration
# Copy this file to .env and update with your configuration

# Backend server URL. All analysis tools require this API in the current release.
VITE_BACKEND_URL=http://localhost:8000

# Optional: Mapbox access token for the satellite / hybrid base map.
# Without it, the satellite base map falls back to Esri raster tiles.
# Either variable is accepted; VITE_MAPBOX_API_KEY takes precedence.
VITE_MAPBOX_API_KEY=
# VITE_MAPBOX_TOKEN=
