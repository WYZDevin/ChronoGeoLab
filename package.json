{
  "name": "chronogeolab",
  "private": true,
  "version": "1.0.1",
  "description": "A local geospatial analysis platform for space-time trajectory analysis with React, deck.gl, and a Flask/GeoPandas backend.",
  "scripts": {
    "dev": "./dev.sh",
    "dev:frontend": "npm --prefix app/front-end run dev",
    "dev:backend": "cd app/back-end && uv run flask --app app run -p 8000 --reload",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WYZDevin/ChronoGeoLab.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/WYZDevin/ChronoGeoLab/issues"
  },
  "homepage": "https://github.com/WYZDevin/ChronoGeoLab#readme",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.10.1",
    "vitepress": "^1.6.3"
  }
}
